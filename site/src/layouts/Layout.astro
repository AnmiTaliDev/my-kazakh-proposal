---
import "../styles/global.css"
import { ThemeToggle } from "@/components/ThemeToggle"
import { locales, pageHref, type PageKey } from "@/i18n/locales"
import type { Content } from "@/i18n/types"

interface Props {
  content: Content
  code: "en" | "kk-cyr" | "kk-lat" | "ru"
  active: PageKey
  title: string
}

const { content, code, active, title } = Astro.props

const current = locales.find((l) => l.code === code)!

const nav: { href: string; label: string }[] = [
  { href: pageHref(current.dir, "home"), label: content.nav.overview },
  { href: pageHref(current.dir, "mapping"), label: content.nav.mapping },
  { href: pageHref(current.dir, "rationale"), label: content.nav.rationale },
  { href: pageHref(current.dir, "example"), label: content.nav.example },
]

const path = new URL(Astro.request.url).pathname
---

<!doctype html>
<html lang={current.htmlLang} class="scheme-light-dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={content.meta.description} />
		<title>{title}</title>
		<script is:inline>
			try {
				const stored = localStorage.getItem("theme")
				const dark =
					stored === "dark" ||
					(!stored && window.matchMedia("(prefers-color-scheme: dark)").matches)
				document.documentElement.classList.toggle("dark", dark)
			} catch (e) {}
		</script>
	</head>
	<body class="min-h-screen bg-background text-foreground antialiased">
		<header class="border-b border-border">
			<div class="mx-auto flex max-w-4xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3">
				<a href={current.dir} class="font-heading text-sm font-semibold shrink-0">
					{content.nav.brand}
				</a>
				<nav class="flex flex-1 flex-wrap gap-x-4 gap-y-1 text-xs/relaxed">
					{
						nav.map((item) => (
							<a
								href={item.href}
								class:list={[
									"rounded-sm px-1.5 py-1 transition-colors hover:text-foreground",
									path === item.href || path === item.href + "/"
										? "font-medium text-foreground"
										: "text-muted-foreground",
								]}
							>
								{item.label}
							</a>
						))
					}
				</nav>
				<div class="flex shrink-0 items-center gap-1">
					<div class="flex items-center gap-0.5 rounded-sm border border-border p-0.5">
						{
							locales.map((l) => (
								<a
									href={pageHref(l.dir, active)}
									aria-current={l.code === code ? "true" : undefined}
									class:list={[
										"rounded-sm px-1.5 py-0.5 text-xs/relaxed transition-colors",
										l.code === code
											? "bg-muted font-medium text-foreground"
											: "text-muted-foreground hover:text-foreground",
									]}
								>
									{l.switchLabel}
								</a>
							))
						}
					</div>
					<a
						href="https://github.com/AnmiTaliDev/my-kazakh-proposal"
						target="_blank"
						rel="noreferrer"
						class="rounded-sm px-2 py-1 text-xs/relaxed text-muted-foreground transition-colors hover:text-foreground"
					>
						GitHub
					</a>
					<ThemeToggle client:load />
				</div>
			</div>
		</header>
		<main class="mx-auto max-w-4xl px-4 py-10">
			<slot />
		</main>
		<footer class="border-t border-border">
			<div class="mx-auto max-w-4xl px-4 py-6 text-xs/relaxed text-muted-foreground">
				<p>{content.footer}</p>
			</div>
		</footer>
	</body>
</html>
